# Public site URL (used for canonical links, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://edustyle.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# Booking backend (Google Calendar). ALL of these must be set for the real
# calendar-backed booking to activate. If any is missing, the site automatically
# falls back to WhatsApp-only booking — nothing breaks.
# ─────────────────────────────────────────────────────────────────────────────

# Google Cloud OAuth client (Calendar API enabled, consent screen in Testing,
# owner added as a test user). Register BOTH redirect URIs on the client:
#   http://localhost:3000/api/auth/callback   (local dev)
#   https://edustyle.vercel.app/api/auth/callback   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only Google account allowed to sign in to /admin and own the calendar.
OWNER_EMAIL=

# Random secret used to sign the admin session cookie.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Upstash Redis / Vercel KV (stores the owner's refresh token + schedule).
# The Vercel Upstash integration injects these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# SMS reminders (optional, on top of the booking backend above). If any of
# these is missing, /api/reminders/run just returns 503 — no effect on booking.
# ─────────────────────────────────────────────────────────────────────────────

# Twilio console (console.twilio.com) → Account SID ("AC…", shown on the
# console home page). Always required.
TWILIO_ACCOUNT_SID=
# Then EITHER the master Auth Token (console home, "reveal" next to the
# Account SID) OR an API Key pair (Console → Account → API keys & tokens →
# Create API key — the SID starts "SK…"). The API Key pair is preferred if
# both are set, and is Twilio's own recommended approach since it can be
# revoked individually without rotating the master token.
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Either an SMS-capable Twilio phone number in E.164 (e.g. +15017122661),
# or a Messaging Service SID (starts "MG…").
TWILIO_FROM_NUMBER=

# Shared secret the GitHub Actions cron (.github/workflows/reminders.yml)
# sends as "Authorization: Bearer <this>". Must match the repo secret of the
# same name. Generate with:  openssl rand -hex 32
CRON_SECRET=
